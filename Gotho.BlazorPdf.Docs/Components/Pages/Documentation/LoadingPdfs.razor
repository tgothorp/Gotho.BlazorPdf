@page "/docs/loading"

<PageTitle>Blazor PDF | Specifying PDFs</PageTitle>

<PageMetadata Title="Blazor PDF | Specifying PDFs"
              Description="PDFs can be loaded by specifying either a URL or a base64 encoded PDF file."
              Url="https://blazorpdf.info/docs/loading"/>

<div style="max-width: 1440px; margin: 3em auto auto;">
    <MudGrid>
        <MudItem sm="3">
            <DocsMenu/>
        </MudItem>
        <MudItem sm="9" Style="overflow: auto">
            <MudText Typo="Typo.h2" Class="mb-5">Loading PDFs</MudText>
            <MudText>PDFs can be loaded by specifying either a URL or a base64 encoded PDF file in the `Url` parameter. PDFs can also be loaded from URL, Base64, Stream or Byte array via the "LoadPdfAsync" function.</MudText>

            <MudText Typo="Typo.h4" Class="mt-5 mb-1">URL Loading</MudText>
            <CodeSnippet Body="@QuickStart.Minimum"/>
            
            <MudText Typo="Typo.h4" Class="mt-5 mb-1">Base64 Loading</MudText>
            <CodeSnippet Body="@Base64Example.Example"/>

            <MudText Typo="Typo.h4" Class="mt-5 mb-1">Loading From Stream</MudText>
            <CodeSnippet Body="@Loading.FromStream"/>
            
            <MudText Typo="Typo.h4" Class="mt-5 mb-1">Loading From Byte Array</MudText>
            <CodeSnippet Body="@Loading.FromByteArray"/>
        </MudItem>
    </MudGrid>
</div>