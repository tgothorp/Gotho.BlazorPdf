@using System.Globalization
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]

<div class="mudpdf_metadata__overlay"></div>
<div class="mudpdf_metadata ">
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">@PdfViewer.LocalizedStrings.MetadataHeader</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataTitle</MudText>
                    <MudText>@MetadataOrEmpty(Metadata.Title)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataSubject</MudText>
                    <MudText>@MetadataOrEmpty(Metadata.Subject)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataAuthor</MudText>
                    <MudText>@MetadataOrEmpty(Metadata.Author)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataCreator</MudText>
                    <MudText>@MetadataOrEmpty(Metadata.Creator)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataProducer</MudText>
                    <MudText>@MetadataOrEmpty(Metadata.Producer)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataPdfFormatVersion</MudText>
                    <MudText>@MetadataOrEmpty(Metadata.FormatVersion)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataKeywords</MudText>
                    <MudText>@MetadataOrEmpty(Metadata.Keywords)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataCreationDate</MudText>
                    <MudText>@(Metadata.CreationDate is null ? "N/A" : Metadata.CreationDate.Value.ToString("g", CultureInfo.CurrentCulture))</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@PdfViewer.LocalizedStrings.MetadataModifiedDate</MudText>
                    <MudText>@(Metadata.ModifiedDate is null ? "N/A" : Metadata.ModifiedDate.Value.ToString("g", CultureInfo.CurrentCulture))</MudText>
                </MudStack>
            
                @if (Metadata.CustomMetadata is not null && Metadata.CustomMetadata.Any())
                {
                    foreach (var customMetadata in Metadata.CustomMetadata)
                    {
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">@customMetadata.Key</MudText>
                            <MudText>@customMetadata.Value</MudText>
                        </MudStack>
                    }
                }
            </MudStack>
        </MudCardContent>
        <MudCardActions Style="flex-direction: row-reverse">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ClearPdfMetadata">Close</MudButton>
        </MudCardActions>
    </MudCard>
</div>

@code {
    [CascadingParameter] public required MudPdfViewer PdfViewer { get; set; }
    
    [Parameter, EditorRequired] public Pdf.PdfMetadata Metadata { get; set; }
    [Parameter, EditorRequired] public EventCallback ClearMetadata { get; set; }
    
    private static string MetadataOrEmpty(string? metadata)
    {
        return string.IsNullOrEmpty(metadata) ? "N/A" : metadata;
    }

    private async Task ClearPdfMetadata()
    {
        await ClearMetadata.InvokeAsync();
    }
}